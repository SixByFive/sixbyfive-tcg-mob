{
  "expo": {
    "name": "SixByFive TCG",
    "slug": "sbf-tcg-mobile",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "tcgmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sixbyfive.sbftcgmobile",
      "associatedDomains": ["applinks:tcg.sixbyfive.com"]
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "package": "com.sixbyfive.sbftcgmobile",
      "permissions": ["NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "tcg.sixbyfive.com",
              "pathPrefix": "/reset-password"
            }
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon-adaptive.png",
          "color": "#2963FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": false
    },

    "extra": {
      "EXPO_PUBLIC_SITE_ORIGIN": "https://tcg.sixbyfive.com",
      "EXPO_PUBLIC_GRAPHQL_ENDPOINT": "https://backendtcg.sixbyfive.com/graphql",
      "EXPO_PUBLIC_ASSET_BASE_URL": "https://backendtcg.sixbyfive.com",
      "EXPO_PUBLIC_SOCKET_URL": "https://backendtcg.sixbyfive.com",

      "EXPO_PUBLIC_DEV_MODE": false,

      "EXPO_PUBLIC_GRAPHQL_ENDPOINT_LOCAL": "http://10.0.2.2:4010/graphql",

      "EXPO_PUBLIC_MESSAGING_GRAPHQL_ENDPOINT_LOCAL": "http://10.0.2.2:4010/graphql",

      "EXPO_PUBLIC_SOCKET_URL_LOCAL": "http://10.0.2.2:4018",
      "EXPO_PUBLIC_SOCKET_PATH": "/realtime/socket.io",

      "router": {},
      "eas": { "projectId": "941ffa41-876d-4f3b-83aa-f66b7f1bb442" }
    },

    "owner": "sixbyfive",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/941ffa41-876d-4f3b-83aa-f66b7f1bb442",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
